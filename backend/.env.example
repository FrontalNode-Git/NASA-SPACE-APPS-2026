# Copy to backend/.env for local work. Never commit .env.
# Real environment variables (for example the ones set on the host) win over this file.

# Optional modules: OFF by default. They are placeholders only, listed on the "Planned next"
# screen. Leave them off until the team says "approve live data".
LIVE_SPACE_WEATHER=false
DISTANCE_ENGINE=false
TRIAGE_PROTOCOLS=false
ECLSS_MODELS=false

# Only needed once LIVE_SPACE_WEATHER is approved. Get a key at api.nasa.gov.
# Leave it empty to use NASA's DEMO_KEY (30 requests an hour).
NASA_API_KEY=

# Reserved for the planned features. NOTHING READS THESE YET: they are here so the numbers are
# not lost, and stay commented out until the matching feature is built and approved.
#
# Space weather (NASA DONKI)
# DONKI_DAYS=7                  # how many days of solar events to show
# DONKI_CACHE_S=900             # refresh every 15 minutes
#
# Demo timings (shortened so they can be shown in a live demo)
# VITAL_EARTH_DELAY_S=20        # signal delay to Earth, as shown in the demo
# VITAL_OFFLINE_AFTER_S=30      # a wearable counts as offline after this many seconds
# VITAL_STILL_TIMEOUT_S=60      # unanswered red alert and no movement: escalate
# VITAL_TIMEOUT_S=180           # unanswered red alert: escalate anyway
# VITAL_LIVE_WINDOW_S=90        # seconds of live readings the engine looks at

# Optional overrides (defaults: ../data and ../frontend/dist).
# VITAL_DATA_DIR=
# VITAL_FRONTEND_DIST=
